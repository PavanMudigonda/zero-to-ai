{
  "name": "next-docs",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <24"
  },
  "scripts": {
    "dev": "next dev",
    "clean": "rm -rf .next out",
    "predev": "node scripts/generate-mermaid-assets.mjs",
    "prebuild": "node scripts/generate-route-index.mjs && node scripts/generate-mermaid-assets.mjs",
    "prebuild:local": "node scripts/generate-mermaid-assets.mjs",
    "build": "npm run clean && NEXT_OUTPUT_MODE=export next build",
    "build:local": "npm run clean && NEXT_OUTPUT_MODE=server next build",
    "start": "NEXT_OUTPUT_MODE=export next start",
    "start:local": "NEXT_OUTPUT_MODE=server next start",
    "lint": "eslint",
    "test:sidebar": "node test-sidebar.spec.js",
    "test:sidebar:live": "BASE_URL=https://zero-to-ai.dev node test-sidebar.spec.js",
    "test:sidebar:all": "node test-sidebar-all.spec.js",
    "test:sidebar:all:live": "BASE_URL=https://zero-to-ai.dev node test-sidebar-all.spec.js",
    "test:mermaid": "node test-mermaid2.js",
    "test:nav-links": "node test-nav-links.mjs",
    "test:nav-links:live": "BASE_URL=https://zero-to-ai.dev node test-nav-links.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.2",
    "@codemirror/lang-python": "^6.2.2",
    "@codemirror/language": "^6.13.2",
    "@codemirror/state": "^6.8.0",
    "@codemirror/view": "^6.44.0",
    "@jupyter-kit/core": "^3.0.1",
    "@jupyter-kit/editor-codemirror": "^3.0.1",
    "@jupyter-kit/executor-pyodide": "^3.0.1",
    "@jupyter-kit/katex": "^3.0.1",
    "@jupyter-kit/react": "^3.0.1",
    "@jupyter-kit/theme-default": "^3.0.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@supabase/ssr": "^0.13.0",
    "@supabase/supabase-js": "^2.118.0",
    "highlight.js": "^11.13.0",
    "katex": "^0.19.1",
    "mermaid": "^11.15.0",
    "next": "^16.4.1",
    "nextra": "^4.7.0",
    "nextra-theme-docs": "^4.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.4.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.1",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.1",
    "playwright": "^1.65.0",
    "puppeteer": "^25.14.0",
    "tailwindcss": "^4",
    "typescript": "^6.1.0"
  },
  "overrides": {
    "zod": "4.3.6"
  }
}
